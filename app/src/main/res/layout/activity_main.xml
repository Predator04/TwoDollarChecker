<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Two Dollar Checker"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#1B5E20" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Enter a bill's details to see if it's worth more than $2"
            android:textSize="13sp"
            android:textColor="#757575" />

        <Button
            android:id="@+id/settings_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="⚙ Settings"
            android:backgroundTint="#37474F" />

        <Button
            android:id="@+id/guide_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="What makes a $2 bill valuable?"
            android:backgroundTint="#607D8B" />

        <Button
            android:id="@+id/scan_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="🎥 Continuous scan with AI"
            android:backgroundTint="#0288D1" />

        <Button
            android:id="@+id/sell_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="💰 How to sell it"
            android:backgroundTint="#EF6C00" />

        <Button
            android:id="@+id/grade_guide_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="🔍 Grading guide"
            android:backgroundTint="#5E35B1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Series"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#212121" />

        <Spinner
            android:id="@+id/series_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Serial number"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#212121" />

        <EditText
            android:id="@+id/serial_edit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="e.g. A12345678A"
            android:inputType="text"
            android:maxLines="1" />

        <CheckBox
            android:id="@+id/star_check"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Star note (★ at end of serial)"
            android:textColor="#212121" />

        <CheckBox
            android:id="@+id/first_day_check"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1976 first-day postmark"
            android:textColor="#212121" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Condition / grade"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#212121" />

        <Spinner
            android:id="@+id/grade_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Printing error (if any)"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#212121" />

        <Spinner
            android:id="@+id/error_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Federal Reserve district (for star notes)"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#212121" />

        <Spinner
            android:id="@+id/district_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp" />

        <Button
            android:id="@+id/check_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Check value"
            android:backgroundTint="#1B5E20" />

        <LinearLayout
            android:id="@+id/result_area"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/result_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#212121" />

            <TextView
                android:id="@+id/reason_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text=""
                android:textSize="14sp"
                android:textColor="#757575" />

            <TextView
                android:id="@+id/score_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text=""
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FB8C00" />

        </LinearLayout>

        <Button
            android:id="@+id/save_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Save to collection"
            android:backgroundTint="#388E3C" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Your collection"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#212121" />

        <TextView
            android:id="@+id/collection_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text=""
            android:textSize="13sp"
            android:textColor="#757575" />

        <LinearLayout
            android:id="@+id/collection_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

    </LinearLayout>
</ScrollView>
